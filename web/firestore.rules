rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Hard-coded bootstrap: this email always has admin rights even before
    // their Firestore role is set, so you can log in and manage the platform
    // from day one.
    function isBootstrapAdmin() {
      let email = request.auth.token.email.lower();
      return email == 'sonam.dobriyal@athenaeducation.co.in'
        || email == 'editor@globalconfluencereview.in';
    }

    // Read the caller's role from their Firestore user profile.
    // Falls back to 'scholar' if the document doesn't exist yet.
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'scholar';
    }

    function getAssignedCategories() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedCategories
        : [];
    }

    function isAdmin() {
      return isSignedIn() && (isBootstrapAdmin() || getUserRole() == 'admin');
    }

    function isEditor() {
      return isSignedIn() && getUserRole() == 'editor';
    }

    function isReviewer() {
      return isSignedIn() && getUserRole() == 'reviewer';
    }

    function editorCanAccessSubmission() {
      return isEditor() && (
        resource.data.assignedEditorId == request.auth.uid
        || resource.data.category in getAssignedCategories()
      );
    }

    function reviewerCanAccessSubmission() {
      return isReviewer() && resource.data.assignedReviewerId == request.auth.uid;
    }

    function submissionDoc(submissionId) {
      return get(/databases/$(database)/documents/submissions/$(submissionId)).data;
    }

    match /issues/{issueId} {
      allow read: if true;
      allow write: if isAdmin();

      match /articles/{articleId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }


    // ── User profiles ───────────────────────────────────────────────────────

    match /users/{uid} {
      // Anyone signed in can read their own profile; admins can read all.
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Admins can list all users (needed for the admin dashboard).
      allow list: if isAdmin();

      // A user can create their own profile document on first sign-in.
      allow create: if isSignedIn() && request.auth.uid == uid;

      // Users can update their own profile EXCEPT role & assignedCategories.
      // Only admins may change those fields.
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == uid &&
        !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('assignedCategories' in request.resource.data.diff(resource.data).affectedKeys())
      );

      // Nobody can delete a user profile through the client SDK.
      allow delete: if isAdmin();
    }


    // ── Submissions ─────────────────────────────────────────────────────────

    match /submissions/{submissionId} {

      // Scholars can read their own submissions.
      // Editors can read submissions in their assigned categories.
      // Admins can read everything.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid)
        || editorCanAccessSubmission()
        || reviewerCanAccessSubmission();

      // Submission creation is server-only so Registration IDs can be allocated
      // atomically and cannot be forged by clients.
      allow create: if false;

      // Registration IDs are permanent, including for administrators.
      allow update: if (isAdmin() || editorCanAccessSubmission())
        && (
          (
            !('registrationId' in resource.data)
            && !('registrationId' in request.resource.data)
          )
          || request.resource.data.registrationId == resource.data.registrationId
        );

      allow delete: if isAdmin();

      match /statusHistory/{eventId} {
        allow read: if isAdmin()
          || (isSignedIn() &&
              submissionDoc(submissionId).authorId == request.auth.uid)
          || (isEditor() &&
              (submissionDoc(submissionId).assignedEditorId == request.auth.uid
               || submissionDoc(submissionId).category in getAssignedCategories()))
          || (isReviewer() &&
              submissionDoc(submissionId).assignedReviewerId == request.auth.uid);

        allow create: if isSignedIn()
          && request.resource.data.changedById == request.auth.uid
          && (
            (
              'registrationId' in submissionDoc(submissionId)
              && request.resource.data.registrationId
                 == submissionDoc(submissionId).registrationId
            )
            || (
              !('registrationId' in submissionDoc(submissionId))
              && request.resource.data.registrationId == submissionId
            )
          )
          && (
            isAdmin()
            || (isEditor() &&
                (submissionDoc(submissionId).assignedEditorId == request.auth.uid
                 || submissionDoc(submissionId).category in getAssignedCategories()))
          );

        allow update, delete: if false;
      }


      // ── Comments (sub-collection) ────────────────────────────────────────

      match /comments/{commentId} {

        // Scholars can read comments on their own submissions.
        // Editors can read comments on submissions in their categories.
        // Admins can read everything.
        allow read: if isAdmin()
          || (isSignedIn() &&
              submissionDoc(submissionId).authorId == request.auth.uid)
          || (isEditor() &&
              (submissionDoc(submissionId).assignedEditorId == request.auth.uid
               || submissionDoc(submissionId).category in getAssignedCategories()))
          || (isReviewer() &&
              submissionDoc(submissionId).assignedReviewerId == request.auth.uid);

        // Editors, reviewers (assigned), and admins may post comments.
        allow create: if request.resource.data.authorId == request.auth.uid && (
          isAdmin()
          || (isEditor() &&
              (submissionDoc(submissionId).assignedEditorId == request.auth.uid
               || submissionDoc(submissionId).category in getAssignedCategories()))
          || (isReviewer() &&
              submissionDoc(submissionId).assignedReviewerId == request.auth.uid)
        );

        // Comments are immutable once posted.
        allow update, delete: if isAdmin();
      }
    }

    // Server-managed uniqueness and sequence records.
    match /registrationCounters/{counterId} {
      allow read, write: if false;
    }

    match /registrationIds/{registrationId} {
      allow read, write: if false;
    }

    // Server-managed notification queue and delivery logs.
    match /notificationQueue/{notificationId} {
      allow read, write: if false;
    }

    match /email_logs/{logId} {
      allow read, write: if false;
    }

    // Admin bulk communications — Admin SDK only (no client access).
    match /emailCampaigns/{campaignId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /emailTemplates/{templateId} {
      allow read, write: if false;
    }

    match /emailSettings/{settingsId} {
      allow read, write: if false;
    }

    match /communications/{docId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Razorpay payment records — Admin SDK only (created/verified on the server).
    match /payments/{paymentId} {
      allow read, write: if false;
    }

  }
}
